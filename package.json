{
  "name": "agentic-learning-studio",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Interactive, personalized agentic-AI lessons. Express, Auth.js, PostgreSQL/pgvector, private S3 storage, and local embeddings.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo": "node scripts/demo.mjs",
    "check": "tsc --noEmit",
    "test:demo": "node scripts/test-demo.mjs",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "ingest": "tsx src/rag/ingest.ts",
    "scan": "tsx src/rag/dailyScan.ts",
    "kb:curate": "tsx services/kb-curator/index.ts",
    "embed:test": "tsx src/rag/embed.test.ts",
    "qa": "node scripts/qa.mjs",
    "auth:claim": "tsx scripts/issue-password-claim.ts",
    "test:auth": "node scripts/test-auth.mjs",
    "test:boundaries": "node --import tsx --test tests/request-scope.test.ts",
    "test:embedding-batches": "node --import tsx --test tests/embedding-batches.test.ts",
    "test:provider-wire": "node --import tsx --test tests/provider-wire.test.ts tests/openai-primary.test.ts"
  },
  "dependencies": {
    "@auth/express": "0.12.3",
    "@aws-sdk/client-s3": "3.1143.0",
    "@huggingface/transformers": "^3.0.0",
    "@langchain/anthropic": "^0.3.0",
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/openai": "0.6.17",
    "@types/cors": "^2.8.19",
    "bcryptjs": "3.0.3",
    "cors": "^2.8.6",
    "csv-parse": "^5.5.0",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-async-errors": "3.1.1",
    "express-rate-limit": "^8.5.2",
    "fast-xml-parser": "^4.5.0",
    "helmet": "^8.2.0",
    "js-yaml": "^4.1.0",
    "katex": "^0.17.0",
    "langfuse-langchain": "^3.0.0",
    "lucide": "1.49.0",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  }
}
