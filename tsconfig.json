{
  // ----------------------------------------------------------------------------
  // TypeScript config tuned for `tsx` (ESM) + Node 18+. Copied from the SEO agent.
  //   - "moduleResolution": "Bundler" lets us write extensionless imports.
  //   - "noEmit": true — `tsx` runs the .ts directly; this config is for type-checking.
  // ----------------------------------------------------------------------------
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src"]
}
