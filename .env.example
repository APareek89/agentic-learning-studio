# Agentic Learning Studio — no secrets belong in this file.
# npm run demo requires none of these settings and never loads .env.
# The real main server requires PostgreSQL + Auth.js settings below.

PORT=5070
APP_URL=http://127.0.0.1:5070
AUTH_URL=http://127.0.0.1:5070
AUTH_SECRET=
DATABASE_URL=
# Verified TLS is required in deployment. The CA file is mounted by the launcher.
DATABASE_SSL_CA_FILE=
# Loopback development only; never use disable for a remote database.
# DATABASE_SSL=disable

# Real auth/storage with cached content; all model generation fails closed.
ALS_MOCK_MODE=1
# Production origin: https://agentic.3-6-183-210.sslip.io
PUBLIC_BASE_URL=http://127.0.0.1:5070

# Private S3 uploads and fixed-name public-thumbnail proxy.
AWS_REGION=ap-south-1
STORAGE_BUCKET=
MEDIA_PUBLIC_BASE_URL=/media
# Optional external thumbnail CDN override (without trailing slash).
THUMBNAIL_BASE_URL=

# Model IDs verified by a read-only provider model listing on 2026-09-30.
# Keys are supplied from SSM at runtime. Keep empty during local development.
ALS_PRIMARY_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_MODEL_OPUS=claude-opus-4-8
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001
# Select openai above to use it for all model tasks, without Anthropic calls.
# Under anthropic primary, this key enables the existing lesson-path fallback.
OPENAI_API_KEY=
OPENAI_MODEL_SONNET=gpt-5.5
OPENAI_MODEL_HAIKU=gpt-5.4-mini

# Explicit admin allowlist; only existing verified-email accounts qualify.
ADMIN_EMAILS=
TRANSFORMERS_CACHE=./.transformers-cache
STALENESS_DAYS=90

# Optional tracing, billing and support email. Leave disabled during review.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_TRIAL_VARIANT_ID=
LEMONSQUEEZY_PAYG_VARIANT_ID=
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=
SUPPORT_TO_EMAIL=
