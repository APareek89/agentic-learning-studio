# ============================================================================
# Agentic Learning Studio — environment settings
# Copy this file to `.env` and fill in values. ONLY ANTHROPIC_API_KEY is required;
# everything else is OPTIONAL and the app degrades gracefully without it.
# ============================================================================

# ---- Claude (REQUIRED) ----
ANTHROPIC_API_KEY=sk-ant-...
# Model tiers (optional — sensible defaults baked in). Sonnet for most work,
# Opus only as a quality escalation, Haiku for cheap one-shots (term definitions).
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_MODEL_OPUS=claude-opus-4-8
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001

# ---- Supabase / Postgres + pgvector (OPTIONAL — turns on RAG + saved generations) ----
# Reuse the existing project. Get the Session-pooler URI from Supabase → Connect.
# Without this, the app still generates from Claude's own knowledge (no RAG).
DATABASE_URL=

# ---- Sign-in / Supabase Auth (OPTIONAL — set BOTH to REQUIRE sign-up/login) ----
# When both are set, /api/learn, /api/upload, /api/module require a signed-in user.
# Leave blank for open/local mode. Find these in Supabase → Project Settings → API.
# (The anon key is PUBLIC — safe to ship to the browser. NEVER use the service_role key.)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Langfuse tracing (OPTIONAL) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com

# ---- Local embeddings (OPTIONAL tuning) ----
# Where the bge-small model weights are cached after first download (~130MB).
TRANSFORMERS_CACHE=./.transformers-cache
# How many days before a retrieved fact is considered "stale" (recency gate).
STALENESS_DAYS=90

# ---- Lemon Squeezy billing / lesson credits (OPTIONAL — turns on paid checkout) ----
# Without these, credits + the gate still work (every user gets the 1 free credit and
# can spend it); only the BUY flow is off (pricing page shows "payments not switched on").
# Use TEST MODE values first, then swap to live. See the dashboard guide in the PR notes.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_TRIAL_VARIANT_ID=
LEMONSQUEEZY_PAYG_VARIANT_ID=
# Where buyers return after checkout (defaults to the request origin if unset).
# Prod: https://agentic-learning-studio.onrender.com  ·  local: http://localhost:5070
APP_URL=

# ---- Support / complaint email (Resend; optional) ----
# Complaints are ALWAYS stored in the DB (support_requests). Email is a best-effort
# notification: without RESEND_API_KEY the server logs the payload (local/dev) and
# still records the complaint — it never drops one.
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=
SUPPORT_TO_EMAIL=findkailash@gmail.com

# ---- Server ----
PORT=5070
